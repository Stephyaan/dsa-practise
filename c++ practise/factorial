factorial of non negative no.
solution:
#include <iostream>
using namespace std;

int factorial(int n) {
    int result = 1;
    for(int i = 1; i <= n; i++) {
        result *= i;
    }
    return result;
}

int main() {
    int n;
    cin >> n;          // Input
    cout << factorial(n);  // Output
    return 0;
}
