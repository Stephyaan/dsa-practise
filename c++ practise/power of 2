Given a postive integer X determine wheter X is a power of 2 or not. If yes return True else False.
X will be called power of 2 if there exits a integer n such that X==
2
n
Example 1:
Input: n = 1
Output: true
Explanation: 
2
0
 = 1 
 
solution:

#include <iostream>
using namespace std;

bool isPowerOfTwo(long long X) {
    if (X <= 0)
        return false;
    return (X & (X - 1)) == 0;
}

int main() {
    long long X;
    cin >> X;                  // Input
    cout << (isPowerOfTwo(X) ? "true" : "false");  // Output
    return 0;
}
