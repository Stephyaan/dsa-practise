Write a program using simplecpp to draw the patterns (examples given below) with each side of length 50 units. 
Nested repeat may be required. As input, you will be given an integer n which denotes the number of sides of the dashed line polygon. 
The dashed segment is required and each dash has a length of 5 units. They are equidistant (total length = 50 units). 5 dashes total per side of the polygon.

#include <simplecpp>
void dashedLine(double length) {
    for (int i = 0; i < 5; i++) {
        forward(5);
        penUp();
        forward(5);
        penDown();
    }
}

int main() {
    int n;
    cin >> n;

    initCanvas("Corner Pattern", 800, 800);

    double angle = 360.0 / n;

    // Draw outer polygon
    penDown();
    for (int i = 0; i < n; i++) {
        forward(50);
        left(angle);
    }

    // Move inward for dashed polygon
    penUp();
    forward(25);
    left(angle / 2);
    penDown();

    // Draw dashed polygon
    for (int i = 0; i < n; i++) {
        dashedLine(50);
        left(angle);
    }

    wait(5);
    return 0;
}

